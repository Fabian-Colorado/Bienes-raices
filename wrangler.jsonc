{
  "name": "bienes-raices",
  "main": "worker.js",
  "compatibility_date": "2026-09-30",

  "assets": {
    "binding": "ASSETS",
    "directory": "."
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "inmobiliaria-db",
      "database_id": "1347afe2-88ee-4a5c-a7f1-9ee31b8bb2a2"
    }
  ],

  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "bienes-raices-images"
    }
  ]
}
