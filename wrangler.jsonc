{
  "name": "bienes-raices",
  "compatibility_date": "2026-09-30",

  "main": "worker.js",

"assets": {
    "directory": ".",
    "binding": "ASSETS",
   "run_worker_first": [
    "/admin-panel.html",
    "/api/*"
]
},
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "inmobiliaria-db",
      "database_id": "1347afe2-88ee-4a5c-a7f1-9ee31b8bb2a2"
    }
  ]
}
